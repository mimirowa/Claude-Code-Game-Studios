{
  "description": "Structured AI Studio state recovery and artifact validation hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"", "timeout": 10, "statusMessage": "Loading canonical project state", "additionalContextLimit": 3000 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/detect-gaps.sh\"", "timeout": 10, "statusMessage": "Checking project readiness", "additionalContextLimit": 2500 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-commit.sh\"", "timeout": 15 },
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-push.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-assets.sh\"", "timeout": 10, "statusMessage": "Validating changed assets" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-compact.sh\"", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-stop.sh\"", "timeout": 3 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/log-agent.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
